{
  "name": "cpprestsdk",
  "version": "2.10.19",
  "port-version": 7,
  "description": "Archived C++ REST SDK with compatibility fixes for current MSVC and restored WebSocket dependencies.",
  "homepage": "https://github.com/Microsoft/cpprestsdk",
  "license": "MIT",
  "dependencies": [
    {
      "name": "boost-asio",
      "platform": "!uwp & !windows"
    },
    {
      "name": "boost-date-time",
      "platform": "!uwp & !windows"
    },
    {
      "name": "boost-regex",
      "platform": "!uwp & !windows"
    },
    {
      "name": "boost-system",
      "platform": "!uwp & !windows"
    },
    {
      "name": "openssl",
      "platform": "!uwp & !windows"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
  "brotli",
    "compression"
  ],
  "features": {
    "brotli": {
      "description": "Brotli compression support",
      "dependencies": [
        "brotli"
      ]
    },
    "compression": {
      "description": "HTTP compression support",
      "dependencies": ["zlib"]
    },
    "websockets": {
      "description": "WebSocket support",
      "dependencies": [
        {
          "name": "boost-asio",
          "platform": "!uwp"
        },
        {
          "name": "boost-date-time",
          "platform": "!uwp"
        },
        {
          "name": "boost-regex",
          "platform": "!uwp"
        },
        {
          "name": "boost-system",
          "platform": "!uwp"
        },
        {
          "name": "openssl",
          "platform": "!uwp"
        },
        {
          "name": "websocketpp",
          "platform": "!uwp"
        }
      ]
    }
  }
}
